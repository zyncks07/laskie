# Laskie RMS — environment configuration template.
#
# Copy to .env and fill in deployment values:
#     cp .env.example .env
#     chmod 600 .env
#     chown www-data:www-data .env   # match the user that runs PHP
#
# .env lives at the project root (NOT inside config/). It is gitignored and
# also blocked by .htaccess so the file is never served. config/env.php loads
# it on every request and define()s the constants below.
#
# Format: KEY=VALUE per line. Values may be quoted; comments start with `#`.

# --- Database -----------------------------------------------------------
DB_HOST=localhost
DB_NAME=laskie_rental
DB_USER=laskie_db_user
DB_PASS=
DB_CHARSET=utf8mb4

# --- Optional: web-relative root ----------------------------------------
# Set this only if the app is mounted under a subdirectory (e.g. /laskie/).
# Leave commented for a vhost-mounted-at-root deployment (the default).
# BASE_URL=/laskie
