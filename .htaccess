# ============================================================
# Laskie Rental Property Management System
# Apache .htaccess
# ============================================================

Options -Indexes +FollowSymLinks

<IfModule php_module>
    php_value session.cookie_httponly   1
    php_value session.use_strict_mode   1
    php_value session.cookie_samesite   Strict
    # HTTPS-only since the vhost on port 49200 is now SSLEngine on.
    # If you ever revert to HTTP, also flip this to 0 or sessions will silently break.
    php_value session.cookie_secure     1
    php_value upload_max_filesize       30M
    php_value post_max_size             35M
    php_value max_execution_time        300
    php_value memory_limit              384M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/    - [F,L]
    RewriteRule ^includes/  - [F,L]
</IfModule>

<FilesMatch "\.(sql|log|env|md|sh|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set X-XSS-Protection        "1; mode=block"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg             "access plus 30 days"
    ExpiresByType image/png              "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
