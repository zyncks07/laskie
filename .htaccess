# ============================================================
# Laskie Rental Property Management System
# Apache .htaccess
# ============================================================

Options -Indexes +FollowSymLinks

<IfModule php_module>
    php_value session.cookie_httponly   1
    php_value session.use_strict_mode   1
    php_value session.cookie_samesite   Strict
    # HTTPS-only since the vhost on port 49200 is now SSLEngine on.
    # If you ever revert to HTTP, also flip this to 0 or sessions will silently break.
    php_value session.cookie_secure     1
    php_value upload_max_filesize       30M
    php_value post_max_size             35M
    php_value max_execution_time        300
    php_value memory_limit              384M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block the Git metadata dir. The <FilesMatch "^\."> rule below only matches
    # dot-prefixed *filenames* (e.g. /.env); a request to /.git/HEAD has the
    # non-dot final segment "HEAD", so it slips past FilesMatch. Block the whole
    # path here so the repo (full source + history) can't be reconstructed via
    # git-dumper. Authoritative block lives in the vhost <DirectoryMatch>.
    RewriteRule "(^|/)\.git"    - [F,L]
    # Block server-only directories. vendor/ ships PHPUnit + sebastian source
    # files; tests/ ships fixtures and bootstrap; migrations/ holds DDL we'd
    # rather not advertise; uploads/ is data, not code. .deploy_credentials
    # is a developer secret that lives at the doc root.
    RewriteRule ^config/        - [F,L]
    RewriteRule ^includes/      - [F,L]
    RewriteRule ^vendor/        - [F,L]
    RewriteRule ^tests/         - [F,L]
    RewriteRule ^migrations/    - [F,L]
    RewriteRule ^scripts/       - [F,L]

    # Gate uploaded files behind a login (audit finding W5-1). Every
    # /uploads/<path> request is internally rewritten to file_gate.php, which
    # calls requireLogin() before streaming the file. No [R] → the URL the
    # browser sees is unchanged; data-stored /uploads/... paths keep working.
    # file_gate.php is not under uploads/, so the rewrite can't loop.
    RewriteRule ^uploads/(.+)$  file_gate.php?p=$1 [L,QSA]
</IfModule>

# Block dotfiles (no extension, leading dot) and the package manifests that
# only matter to Composer. PHP files in subdirectories blocked above are also
# covered by the RewriteRules — this is defence-in-depth for direct hits.
<FilesMatch "\.(sql|log|env|md|sh|lock|json|dist)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>
<Files "seed_spreadsheet.php">
    Order Allow,Deny
    Deny from all
</Files>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    # X-XSS-Protection intentionally NOT set. The header is deprecated:
    # Chrome removed support, Firefox never implemented, and OWASP notes
    # it can introduce vulns on legacy IE/Edge. Modern XSS defence lives
    # in the per-page esc()/safeUrl() helpers and CSP (future work).
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg             "access plus 30 days"
    ExpiresByType image/png              "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
